# Всё, что лежит в `api/`, Vercel превращает в отдельную функцию по имени файла.
# Тесты рядом с функцией — это удобно нам и бессмысленно в проде: они стали бы
# эндпоинтами `/api/og/join.test` и `/api/og/routing.test`. Второй к тому же без
# default-экспорта, то есть сборка функций на нём споткнётся.
api/**/*.test.ts

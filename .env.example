# ─── Backend (локальная разработка) ──────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/groupmatch
SPRING_DATASOURCE_USERNAME=dev
SPRING_DATASOURCE_PASSWORD=devpass
SPRING_REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-key-change-in-production-min-256-bits-12345678901234567890

# ─── Frontend (локальная разработка) ─────────────────────────────────────────
VITE_API_URL=http://localhost:8080


# ═══════════════════════════════════════════════════════════════════════════
# Прод: справочно. Эти значения живут в дашбордах, а не в репозитории.
# Порядок перехода на api.groupmatch.app — docs/api-subdomain-migration.md.
# ═══════════════════════════════════════════════════════════════════════════
#
# Railway → Variables (бэкенд):
#   API_BASE_URL=https://api.groupmatch.app      ← МЕНЯЕТСЯ (было *.up.railway.app)
#   APP_BASE_URL=https://groupmatch.app          ← не меняется, это адрес фронта
#   CORS_ALLOWED_ORIGINS=https://groupmatch.app  ← НЕ меняется: здесь перечислены
#       origin'ы страниц, которые ходят в API. Перенос самого API на другой
#       поддомен origin страницы не меняет. Добавлять сюда api.groupmatch.app
#       не нужно и бессмысленно.
#   TRUSTED_PROXIES=<см. docs/api-subdomain-migration.md, шаг 4>
#       ← МЕНЯЕТСЯ после проксирования через Cloudflare: к цепочке добавляется
#       хоп, и без диапазонов Cloudflare в этом списке rate-limit начнёт
#       считать всех по IP эджа, то есть одним общим счётчиком. Готовая
#       строка и проверка — в runbook'е. IPv6-диапазоны Cloudflare туда пока
#       не входят, см. там же «Что осталось открытым».
#   SPRING_PROFILES_ACTIVE=prod
#
# Vercel → Settings → Environment Variables (фронтенд, Production):
#   VITE_API_URL=https://api.groupmatch.app      ← МЕНЯЕТСЯ (было *.up.railway.app)
#       Значение подставляется на этапе сборки, поэтому после его смены нужен
#       redeploy — просто перезапуска недостаточно.
